#!/bin/sh
# ship-code: copy Wimym's code to the private repo people are invited to (matrice-technologies/wimym), as one new
# commit on that repo's own history. The copy leaves out what is only ours: the research notes and the build
# sprint's notes. Nothing from ~/.wimym or ~/.cache/wimym is ever in git, so nothing of that goes either.
# What changed since the last ship (the subjects of what landed on main) goes in the commit and at the top of the
# copy's CHANGES.md, which `./install.sh --update` shows them.
#
#   bin/ship-code              # ship main
#   bin/ship-code HEAD         # ship another ref
#   bin/ship-code --dry-run    # list what would go and what CHANGES.md would gain, push nothing
set -eu
REPO="${WIMYM_SHIP_REPO:-matrice-technologies/wimym}"
LEAVE_OUT="docs/research docs/sprint.md CHANGES.md"  # CHANGES.md: the copy keeps its own, written below

dry=0; ref=main
for a in "$@"; do
  case "$a" in
    --dry-run) dry=1 ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    *) ref="$a" ;;
  esac
done
here=$(cd "$(dirname "$0")/.." && pwd)
sha=$(git -C "$here" rev-parse --short "$ref")
excludes=""
for p in $LEAVE_OUT; do excludes="$excludes :(exclude)$p"; done

if [ "$dry" = 1 ]; then
  # shellcheck disable=SC2086
  git -C "$here" archive "$ref" -- . $excludes | tar -t | grep -v '/$'
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/wimym-ship.XXXXXX")
case "$work" in */wimym-ship.*) ;; *) echo "Stopped: unexpected work folder $work" >&2; exit 1 ;; esac
trap 'rm -rf "$work"' EXIT  # only the temporary folder made above

if [ "$dry" = 1 ]; then
  git clone -q --depth 1 "https://github.com/$REPO.git" "$work/repo" 2>/dev/null \
    || { echo "(can't reach $REPO, so no CHANGES.md preview)"; exit 0; }
else
  git clone -q "https://github.com/$REPO.git" "$work/repo"
fi
cd "$work/repo"

# what landed on main since the last ship, by its merges' subjects: "Merge the postcard of a day (claude/…)" says
# "The postcard of a day". Merges of main into a branch, and the site's own commits, are nothing to tell.
last=$(git log -1 --format=%s 2>/dev/null | sed -n 's/^Wimym as of \([0-9a-f]\{7,\}\).*/\1/p')
if [ -n "$last" ] && git -C "$here" cat-file -e "$last^{commit}" 2>/dev/null; then
  range="$last..$ref"
else
  range="$ref"  # the first ship, or one from a history this repository doesn't have: the last few
fi
notes=$(git -C "$here" log --first-parent --format=%s "$range" -n 40 \
  | sed -e 's/^Merge //' -e 's/ ([^() ]*\/[^() ]*)$//' \
  | grep -vE "^(branch |remote-tracking |main[: ]|Site: |'?refs/heads/)" \
  | awk '{ print "- " toupper(substr($0, 1, 1)) substr($0, 2) }' || true)
[ -n "$notes" ] || notes="- Small fixes."
entry=$(printf '## %s\n\n%s\n' "$(date '+%-d %B %Y')" "$notes")

if [ "$dry" = 1 ]; then
  printf '\nCHANGES.md would gain:\n\n%s\n' "$entry"
  exit 0
fi

changes=$(cat CHANGES.md 2>/dev/null || true)
# replace the copy's files with the ref's, so files deleted here are deleted there too
git ls-files -z | xargs -0 rm -f
# shellcheck disable=SC2086
git -C "$here" archive "$ref" -- . $excludes | tar -x -C "$work/repo"
git add -A
if git diff --cached --quiet; then echo "Nothing new to ship."; exit 0; fi
{
  printf '# What changed in Wimym\n\nNewest first. `./install.sh --update` brings the latest, and says what is new.\n\n%s\n\n' "$entry"
  printf '%s\n' "$changes" | awk 'f || /^## /{ f = 1; print }'  # the earlier entries, without their heading
} | cat -s > CHANGES.md
git add CHANGES.md
git commit -q -F - <<EOF
Wimym as of $sha

$notes
EOF
git -c http.postBuffer=524288000 push -q origin HEAD:main  # a first push with the images is too big for the default buffer
echo "Shipped $sha to https://github.com/$REPO"
printf '%s\n' "$entry"
